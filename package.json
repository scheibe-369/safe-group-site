    "check:skills": "node scripts/validate-skills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.10",
    "@types/three": "^0.170.0",
    "framer-motion": "^12.38.0",
