    "next": "15.5.23",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "split-type": "^0.3.4",
    "swiper": "^11.2.10",
    "three": "^0.170.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
